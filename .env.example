# Copy to .env.local and fill in. Only JWT_SECRET is required to run in production.

# REQUIRED in production: secret used to sign/verify session JWTs.
# Generate one with:  openssl rand -hex 32
# If unset in production the app generates and persists a random secret to
# .jwt-secret (single-host only) and logs a warning — set this for real deployments.
JWT_SECRET=

# Database adapter: "memory" (default, in-process, resets on restart) or "mongodb".
DB_TYPE=memory

# Only needed when DB_TYPE=mongodb:
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=taskflow
